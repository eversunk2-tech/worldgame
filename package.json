{
  "name": "play1",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "2D educational RPG v0.2 (elementary social studies): Kenney tile atlas, character parts, world-atlas map, Galmuri UI, ZEP-style presence, code-generated audio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:check": "node scripts/fetch-assets.mjs --check"
  },
  "dependencies": {
    "express": "^4.21.0",
    "galmuri": "^2.40.3",
    "phaser": "^3.90.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
